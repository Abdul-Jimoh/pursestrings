{
  "name": "pursestrings-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome check . && pnpm --filter @pursestrings/web lint:classes",
    "format": "biome check --write . && pnpm --filter @pursestrings/web lint:classes --write",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
